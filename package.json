{
  "name": "lovense-control-panel",
  "version": "1.0.0",
  "description": "Lovense Control Panel with real-time chat and monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js",
    "preview:day1": "node --env-file-if-exists=.env learn/day1-preview-server.js",
    "test": "node --test learn/*.test.js learn/evals/*.test.js tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "eval:day1": "node learn/evals/run-day1-evals.js --dry-run",
    "eval:day1:live": "node learn/evals/run-day1-evals.js --live"
  },
  "keywords": [
    "lovense",
    "control",
    "websocket",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^30.0.1",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
