# Copy this file to .env for LOCAL development. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://control_panel:change-me@127.0.0.1:5432/control_panel
# disable (local/private connection), require (TLS without certificate check),
# verify-full (TLS with certificate verification; preferred for a public DB).
DATABASE_SSL=disable
# Replace with a long random secret before registering the initial administrator.
MASTER_INVITE_CODE=replace-with-a-long-random-secret

# Optional: needed only for real Day 1 grading. Tests never call xAI.
XAI_API_KEY=
TRAINING_DAY1_ENABLED=1
DAY1_GROK_CONCURRENCY=2
DAY1_GROK_QUEUE_LIMIT=20
XAI_TIMEOUT_MS=60000
